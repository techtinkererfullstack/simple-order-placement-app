<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddOrderScreen"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/background"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:text="Add Order"
        android:textAlignment="center"
        android:textColor="@color/text"
        android:padding="30dp"
        android:textSize="20sp"
        android:textStyle="bold"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
       android:paddingHorizontal="30dp"
        >


        <EditText
            android:background="@drawable/edit_text_border"
            android:id="@+id/dateET"
            android:hint="Enter Date"
            android:padding="8dp"
            android:layout_marginTop="60dp"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <EditText
            android:background="@drawable/edit_text_border"
            android:id="@+id/customer_nameET"
            android:hint="Customer Name"
            android:padding="8dp"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <EditText
            android:background="@drawable/edit_text_border"
            android:id="@+id/mobile_numberET"
            android:hint="Enter your Mobile Number"
            android:padding="8dp"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <EditText
            android:background="@drawable/edit_text_border"
            android:id="@+id/addressET"
            android:hint="Enter your Address"
            android:padding="8dp"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />



        <EditText
            android:background="@drawable/edit_text_border"
            android:id="@+id/product_detailsET"
            android:hint="Enter Product Details"
            android:padding="8dp"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <EditText
            android:background="@drawable/edit_text_border"
            android:id="@+id/quantityET"
            android:hint="Enter your quantity"
            android:padding="8dp"
            android:layout_marginTop="30dp"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />







    </LinearLayout>

    <Button
        android:id="@+id/order_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Order"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="24dp"
        />



</LinearLayout>